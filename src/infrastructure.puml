@startuml
component Infrastructure {

    enum GameObjType {
        PLAYER
        ENEMY
        NPC
        PROP
    }

    class RandomGenerator {
        + nextInt(min: int, max: int): int
        + nextDouble(): double
        + getRandomPoint(bounds: Rect): Point
    }

    class Storage {
        - resourcesPath: Path
        + loadScene(name: String): SceneData
        + saveScene(scene: Scene): void
        + getSprite(spriteIdent: int): Sprite
    }

    ' === РЕАЛИЗАЦИЯ ПАТТЕРНА СТРОИТЕЛЬ ===
    class ConcreteMapBuilder implements Domain.IMapBuilder {
        - storage: Storage
        - random: RandomGenerator
        - scene: Domain.Scene
        + setDimensions(width: int, height: int): ConcreteMapBuilder
        + buildTerrain(): ConcreteMapBuilder
        + spawnMobs(factory: Domain.IGameFactory, count: int): ConcreteMapBuilder
        + spawnItems(factory: Domain.IGameFactory, count: int): ConcreteMapBuilder
        + loadFromFile(filePath: String): ConcreteMapBuilder
        + getResult(): Domain.Scene
    }

    class TileEngine {
        - spriteCache: Map<int, Sprite>
        + renderMap(display: Presentation.Screen, levelMap: int[][], tiles: Map<int, Domain.Tile>)       
        + renderSprite(display: Presentation.Screen, x: int, y: int, spriteIdent: int)
        + renderText(display: Presentation.Screen, x: int, y: int, text: String)
        - loadSprite(spriteIdent: int): Sprite
    }

    class SceneData {
        + sceneName: String
        + mapLayout: int[][]
        + gameObjects: List<GameObjectData>
    }

    class GameObjectData {
        + type: GameObjType
        + x: int
        + y: int
        + components: List<ComponentData>
    }

    class ComponentData {
        + name: String
        + properties: Map<String, ISerializable>
    }

    class Sprite {
        + ident: String
        + pixels: Color[][]
        + width: int
        + height: int
    }

    Storage ..> SceneData : <<use>>
    Storage ..> Sprite : <<use>>
    ConcreteMapBuilder --> Storage : "reads data"
    ConcreteMapBuilder --> RandomGenerator : "generates coordinates"
    SceneData *-- GameObjectData : "contains list of"
    GameObjectData *-- ComponentData : "contains list of"
    TileEngine ..> Storage : "fetches sprites"
    GameObjectData ..> GameObjType : <<use>>
@enduml
