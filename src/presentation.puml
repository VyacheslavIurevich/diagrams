@startuml
namespace Presentation {
    class IOManager {
        - availibleCommands: Map<Input, Command>
        + callRenderer(input: Input, buffer: int[][])
    }
    class Input {
        + pollKeyboard(): InputAction
        + isKeyPressed(key: String): boolean
    }

    class Screen {
        buffer: int[][]
        + clear()
        + drawPixel(x: int, y: int, color: Color)
        + drawSprite(x: int, y: int, sprite: int[][])
        + refresh()
    }

    class Command {
        + execute()
    }

    enum InputAction {
        MOVE_UP
        MOVE_DOWN
        MOVE_LEFT
        MOVE_RIGHT
        USE_ITEM
        EXIT
    }

    Input ..> InputAction : <<use>>
    IOManager -- Input
    IOManager -- Screen
    IOManager *--> Command
}
@enduml