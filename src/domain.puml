@startuml
namespace Domain {

    enum TilePassability {
        WALKABLE
        BLOCKED
        WATER
        LAVA
        FLY_ONLY
    }

    ' === ПАТТЕРН: ПРОТОТИП ===
    interface ICloneable<T> {
        + clone(): T
    }

    class Item implements ICloneable {
        + ident: String
        + name: String
        + position: Point
        - effect: IEffect
        + apply(target: GameObj)
        + clone(): Item
    }

    interface IEffect {
        + execute(target: GameObj)
    }

    class GameObj implements ICloneable {
        + ident: String
        + position: Point
        - components: List<IComponent>
        + getComponent<T>(): T
        + addComponent(comp: IComponent)
        + clone(): GameObj
    }

    interface IComponent {
        + type: ComponentType
    }

    class Tile {
        + ident: int
        + spriteIdent: int
        + passability: TilePassability
    }

    class Scene {
        + name: String
        + ident: String
        + entities: List<GameObj>
        + items: List<Item>
        + tiles: Map<int, int, Tile>
        + mainCharacterIdent: String
        + levelMap: int[][]
    }

    ' === ПАТТЕРН: АБСТРАКТНАЯ ФАБРИКА ===
    interface IGameFactory {
        + createMob(type: String, p: Point): GameObj
        + createItem(type: String, p: Point): Item
    }

    class HellFactory implements IGameFactory {
        + createMob(type: String, p: Point): GameObj
        + createItem(type: String, p: Point): Item   
    }

    class GreekFactory implements IGameFactory {
        + createMob(type: String, p: Point): GameObj 
        + createItem(type: String, p: Point): Item   
    }

    ' === ПАТТЕРН: СТРОИТЕЛЬ ===
    interface IMapBuilder {
        + setDimensions(width: int, height: int): IMapBuilder
        + buildTerrain(): IMapBuilder
        + spawnItems(factory: IGameFactory, count: int): IMapBuilder
        + spawnMobs(factory: IGameFactory, count: int): IMapBuilder
        + loadFromFile(filePath: String): IMapBuilder
        + getResult(): Scene
    }

    class Plot {
        - random: Infrastructure.RandomGenerator
        - storage: Infrastructure.Storage
        - currentFactory: IGameFactory
        + setFactory(factory: IGameFactory)
        + uploadScene(builder: IMapBuilder, name: String): Scene
        + generateScene(builder: IMapBuilder, seed: int): Scene
        + dealDamage(source: GameObj)
        + moveObject(obj: GameObj, direction: Vector)
        + canMoveTo(x: int, y: int, movementType: MovementType): boolean
        + exitGame()
    }

    enum MovementType {
        WALK
        FLY
        SWIM
    }

    ' Relationships
    Plot -> Scene : "manages state"
    Plot --> IGameFactory : "uses for context"
    Plot ..> IMapBuilder : "directs construction"
    Scene *-- GameObj
    Scene *-- Item
    Scene *-- Tile : "tile definitions"
    Item *-- IEffect : "contains"
    GameObj *-- IComponent : "composed of"
    IEffect ..> GameObj : "modifies via getComponent()"
    Tile ..> TilePassability : <<use>>
    Plot ..> MovementType : <<use>>
    Plot ..> Tile : "checks passability"

}
@enduml
