@startuml
namespace Domain {

    enum TilePassability {
        WALKABLE
        BLOCKED
        WATER
        LAVA
        FLY_ONLY
    }

    class Item {
        + ident: String
        + name: String
        + position: Point
        - effect: IEffect
        + apply(target: GameObj)
    }

    interface IEffect {
        + execute(target: GameObj)
    }

    class GameObj {
        + ident: String
        + position: Point
        - components: List<IComponent>
        + getComponent<T>(): T
        + addComponent(comp: IComponent)
    }

    interface IComponent {
        + type: ComponentType
    }

    class Tile {
        + ident: int
        + spriteIdent: int
        + passability: TilePassability
    }

    class Scene {
        + name: String
        + ident: String
        + entities: List<GameObj>
        + items: List<Item>
        + tiles: Map<int, int, Tile>
        + mainCharacterIdent: String
        + levelMap: int[][]
    }

    class Plot {
        - random: Infrastructure.RandomGenerator
        - storage: Infrastructure.Storage
        + uploadScene(name: String): Scene
        + generateScene(seed: int): Scene
        + dealDamage(source: GameObj)
        + moveObject(obj: GameObj, direction: Vector)
        + canMoveTo(x: int, y: int, movementType: MovementType): boolean
        + exitGame()
    }

    enum MovementType {
        WALK
        FLY
        SWIM
    }

    ' Relationships
    Plot -> Scene : "manages state"
    Scene *-- GameObj
    Scene *-- Item
    Scene *-- Tile : "tile definitions"
    Item *-- IEffect : "contains"
    GameObj *-- IComponent : "composed of"
    IEffect ..> GameObj : "modifies via getComponent()"
    Tile ..> TilePassability : <<use>>
    Plot ..> Tile : "checks passability"
    Plot ..> TilePassability : <<use>>
    Plot ..> MovementType : <<use>>
}
@enduml
